<% e = @execution %>
<% content_for :title, e.label %>
<% content_for :crumbs do %>
  <%= link_to "Executions", executions_path %><span class="sep">/</span><%= link_to e.ticket.key, ticket_path(e.ticket) %><span class="sep">/</span><span>exec-<%= e.attempt.to_s.rjust(3, "0") %></span>
<% end %>
<% content_for :actions do %>
  <% if e.active? && can?("execution.cancel") %>
    <%= button_to cancel_execution_path(e), class: "btn btn-sm btn-danger", form: { style: "display:inline" } do %><%= icon("stop", size: 12) %> Cancel<% end %>
  <% elsif e.terminal? && e.provider_key != "local" && can?("execution.start") %>
    <% if e.metadata["provider_session_id"] && Agentboard::Providers.registry.registered?(e.provider_key) && Agentboard::Providers.registry.fetch(e.provider_key).supports?(:session_resume) && e.worktree_path && File.directory?(e.worktree_path) %>
      <details class="popover">
        <summary class="btn btn-sm"><%= icon("play", size: 12) %> Resume session…</summary>
        <div class="popover-panel" style="min-width:320px">
          <%= form_with url: resume_execution_path(e), class: "stack-sm", style: "padding:6px" do %>
            <textarea name="message" class="textarea" style="min-height:70px" placeholder="Message to the agent (default: Continue the task.)"></textarea>
            <button class="btn btn-primary btn-sm">Resume in the same worktree</button>
          <% end %>
        </div>
      </details>
    <% end %>
    <%= button_to retry_execution_path(e), class: "btn btn-sm", form: { style: "display:inline" } do %><%= icon("refresh", size: 12) %> Retry as new attempt<% end %>
  <% end %>
<% end %>

<div class="row mb" style="gap:12px">
  <%= provider_avatar(e.provider_key, size: 34) %>
  <div class="grow">
    <h1 style="display:flex;gap:10px;align-items:center"><%= e.action.humanize %> <span class="muted" style="font-weight:500"><%= e.ticket.title %></span></h1>
    <div class="row muted" style="font-size:12.5px;margin-top:2px">
      <%= execution_pill(e.status) %>
      <span><%= Agentboard::Providers.registry.registered?(e.provider_key) ? Agentboard::Providers.registry.adapter_class(e.provider_key).display_name : e.provider_key %></span>
      <% if e.branch %><span>·</span><%= icon("branch", size: 13) %><code><%= e.branch %></code><% end %>
      <span>·</span><span class="prov <%= e.metadata["isolation"] == "container" ? "prov-git-observed" : "prov-provider-reported" %>" title="<%= e.metadata["isolation"] == "container" ? "Ran in #{e.metadata["image"]} on an internal network with an egress allowlist" : "Ran as a trusted local subprocess" %>"><%= e.metadata["isolation"] == "container" ? "container" : "local process" %></span>
      <% if e.metadata["provider_session_id"] %><span>·</span><span title="Provider session id">session <code><%= e.metadata["provider_session_id"].to_s[0, 12] %></code></span><% end %>
    </div>
  </div>
</div>

<% if e.status == "queued" && !@daemon[:running] %>
  <div class="callout callout-warn mb"><%= icon("clock", size: 16) %><div>Queued. Start the runtime to pick it up: <code>bundle exec agentboard daemon start</code></div></div>
<% end %>
<% if @pending_approvals.any? %>
  <div class="card mb" style="border-color:var(--c-amber)">
    <div class="card-head"><h2><%= icon("shield", size: 15) %> The agent is waiting for your permission</h2><span class="muted" style="margin-left:auto;font-size:12px">It continues as soon as you decide</span></div>
    <div class="card-body stack"><% @pending_approvals.each do |a| %><%= render "agentboard/approvals/approval", approval: a %><% end %></div>
  </div>
<% end %>
<% if e.failure_message.present? %>
  <div class="callout <%= e.status == "interrupted" ? "callout-warn" : "callout-bad" %> mb"><%= icon("alert", size: 16) %><div><strong><%= e.failure_code.to_s.humanize %>.</strong> <%= e.failure_message %></div></div>
<% end %>

<div class="exec-hero mb">
  <div><div class="stat-label">Duration</div><div class="stat-value"><%= icon("clock", size: 14, klass: "muted") %><%= duration(e.duration) %></div></div>
  <div><div class="stat-label">Base → head</div><div class="stat-value"><%= sha_tag(e.base_sha) %> <%= icon("arrow-right", size: 12, klass: "faint") %> <%= sha_tag(e.head_sha) %></div></div>
  <div><div class="stat-label">Checks</div><div class="stat-value"><%= @results.count(&:passed?) %><span class="muted">/<%= @results.size %></span></div></div>
  <div><div class="stat-label">Tokens (reported)</div><div class="stat-value">
    <% tin = @usage.sum { |u| u.input_tokens.to_i }; tout = @usage.sum { |u| u.output_tokens.to_i } %>
    <%= @usage.any? ? "#{number_with_delimiter(tin)} / #{number_with_delimiter(tout)}" : "—" %></div></div>
  <div><div class="stat-label">Resources</div><div class="stat-value" style="font-size:13px">
    <% if (r = e.metadata["resources"]) %><%= number_to_human_size(r["peak_rss_kb"].to_i * 1024) %> peak · <%= r["cpu_seconds"] %>s CPU<% else %>—<% end %></div></div>
  <div><div class="stat-label">Heartbeat</div><div class="stat-value" style="font-size:13px"><%= e.heartbeat_at ? ago(e.heartbeat_at) : "—" %><% if e.pid && e.active? %> <span class="faint mono" style="font-size:11px">pid <%= e.pid %></span><% end %></div></div>
</div>

<div class="detail" style="grid-template-columns:minmax(0,1fr) 380px">
  <div class="stack">
    <div class="console" data-controller="log" data-log-url-value="<%= log_execution_path(e) %>" data-log-active-value="<%= e.active? %>">
      <div class="console-head"><span class="dots"><i></i><i></i><i></i></span><%= icon("terminal", size: 13) %> agent output <span style="margin-left:auto">redacted<%= " · truncated" if e.log_truncated %></span></div>
      <pre class="console-body" data-log-target="body"></pre>
    </div>
    <div class="card">
      <div class="card-head"><h2><%= icon("pulse", size: 15) %> Event stream</h2><span class="muted" style="margin-left:auto;font-size:12px">Model reasoning is never captured</span></div>
      <div class="stream">
        <% if @events.empty? %><div class="empty" style="padding:20px">No events yet.</div><% end %>
        <% @events.each do |ev| %>
          <% ic, tone = event_icon(ev) %>
          <div class="stream-row is-<%= tone %>">
            <time><%= ev.occurred_at.strftime("%H:%M:%S") %></time>
            <%= icon(ic, size: 14) %>
            <div style="min-width:0;word-break:break-word"><%= event_title(ev) %></div>
            <%= provenance_badge(ev.provenance) %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="stack">
    <div class="card">
      <div class="card-head"><h3><%= icon("flask", size: 14) %> Verification</h3></div>
      <div class="card-body-flush">
        <% if @results.empty? %><div class="empty" style="padding:18px"><span>Runs after the agent finishes, against the snapshot commit.</span></div><% end %>
        <% @results.each do |r| %>
          <div class="check-row" style="flex-wrap:wrap">
            <%= execution_pill(r.status) %><strong class="mono" style="font-size:12.5px"><%= r.name %></strong>
            <span class="muted" style="font-size:12px"><%= r.required ? "required" : "optional" %> · <%= r.duration_seconds ? "#{r.duration_seconds.round(1)}s" : "…" %></span>
            <span style="margin-left:auto"><%= sha_tag(r.commit_sha) %></span>
            <% if r.output_excerpt.present? %>
              <details class="output" style="flex-basis:100%"><summary>Show output</summary><pre><%= r.output_excerpt %></pre></details>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h3><%= icon("layers", size: 14) %> Artifacts</h3></div>
      <div class="card-body-flush">
        <% if @artifacts.empty? %><div class="empty" style="padding:18px">None yet.</div><% end %>
        <% @artifacts.each do |a| %>
          <div class="list-row"><%= icon(a.kind == "commit" ? "commit" : (a.kind == "context" ? "layers" : "file"), size: 14, klass: "muted") %>
            <span class="grow truncate"><%= a.title.presence || a.kind.humanize %><% if a.kind == "commit" && a.metadata["files"].present? %><br><span class="faint mono" style="font-size:11px"><%= Array(a.metadata["files"]).first(4).join(", ") %></span><% end %></span>
            <%= provenance_badge(a.provenance) %></div>
        <% end %>
      </div>
    </div>
    <div class="card"><div class="card-body">
      <dl class="kv">
        <dt>Worktree</dt><dd class="mono truncate" style="font-size:11.5px" title="<%= e.worktree_path %>"><%= e.worktree_path ? e.worktree_path.sub(Agentboard.config.root_path.to_s + "/", "") : "—" %></dd>
        <dt>Context</dt><dd><% if e.context_digest %><code title="<%= e.context_digest %>"><%= e.context_digest[0, 10] %></code><% else %>—<% end %></dd>
        <dt>Exit code</dt><dd><%= e.exit_code.nil? ? "—" : e.exit_code %></dd>
        <dt>Requested by</dt><dd><%= e.metadata["requested_by"] || "—" %></dd>
        <% if e.metadata["resume_of"] %><dt>Resumes</dt><dd><%= link_to "previous attempt", execution_path(e.metadata["resume_of"]), class: "link" %></dd><% end %>
        <% if e.metadata["retry_of"] %><dt>Retry of</dt><dd><%= link_to "previous attempt", execution_path(e.metadata["retry_of"]), class: "link" %></dd><% end %>
        <% if (cost = @usage.find(&:reported_cost)) %><dt>Reported cost</dt><dd><%= number_to_currency(cost.reported_cost, unit: cost.currency == "USD" ? "$" : "#{cost.currency} ", precision: 4) %> <span class="faint" style="font-size:11px">provider-reported</span></dd><% end %>
      </dl>
    </div></div>
  </div>
</div>
